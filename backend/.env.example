PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated list for multiple frontend domains
# FRONTEND_URLS=https://your-app.vercel.app,https://your-preview.vercel.app

# Salon
SALON_NAME=Your Salon

# Admin seed (run npm run seed once)
ADMIN_EMAIL=admin@salon.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Salon Admin

# WhatsApp session path
WHATSAPP_SESSION_PATH=./.wwebjs_auth

# Cron timezone
CRON_TIMEZONE=Asia/Kolkata

# Auto-init WhatsApp on server start
AUTO_INIT_WHATSAPP=true

# Retry WhatsApp initialization after disconnects (milliseconds)
WHATSAPP_RECONNECT_DELAY_MS=30000

# Puppeteer cache directory (recommended on Render so Chrome is available at runtime)
PUPPETEER_CACHE_DIR=./.cache/puppeteer

# Puppeteer executable path (optional, use if Chrome/Chromium is preinstalled on host)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# PUPPETEER_CACHE_DIR=./.cache/puppeteer
