PORT=5000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Salon
SALON_NAME=Your Salon

# Admin seed (run npm run seed once)
ADMIN_EMAIL=admin@salon.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Salon Admin

# WhatsApp session path
WHATSAPP_SESSION_PATH=./.wwebjs_auth

# Cron timezone
CRON_TIMEZONE=Asia/Kolkata

# Auto-init WhatsApp on server start
AUTO_INIT_WHATSAPP=true

# Retry WhatsApp initialization after disconnects (milliseconds)
WHATSAPP_RECONNECT_DELAY_MS=30000

# Puppeteer (Render/Linux — optional, set if Chromium is installed on host)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
